{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/reports/file.js",
      "use": "@vercel/node"
    },
    {
      "src": "web/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "web/login.html",
      "use": "@vercel/static"
    },
    {
      "src": "web/contact.html",
      "use": "@vercel/static"
    },
    {
      "src": "web/app.js",
      "use": "@vercel/static"
    },
    {
      "src": "web/style.css",
      "use": "@vercel/static"
    },
    {
      "src": "web/professional.html",
      "use": "@vercel/static"
    },
    {
      "src": "web/reem.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/contact.html",
      "dest": "/web/contact.html"
    },
    {
      "src": "/api/auth/request",
      "dest": "/api/auth/request.js"
    },
    {
      "src": "/api/auth/requests",
      "dest": "/api/auth/requests.js"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/health.js?route=auth-login"
    },
    {
      "src": "/api/auth/me",
      "dest": "/api/health.js?route=auth-me"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/",
      "dest": "/web/login.html"
    },
    {
      "src": "/professional.dashboard",
      "dest": "/web/professional.html"
    },
    {
      "src": "/control-center",
      "dest": "/web/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/web/$1"
    }
  ]
}
